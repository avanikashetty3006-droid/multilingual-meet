# Copy to .env (never commit .env). Every value below is REQUIRED unless it shows a default.

# --- Google sign-in (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, Web) ---
GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# --- Your public addresses ---
SITE_HOST=meet.example.com
PUBLIC_URL=https://meet.example.com
LIVEKIT_PUBLIC_HOST=lk.example.com
LIVEKIT_URL=wss://lk.example.com
PROXY_HOPS=2            # 2 when using the bundled Caddy (profile "tls"), 1 when nginx is the edge
FRONTEND_PORT=8080      # only used without Caddy

# --- Secrets: generate your own! ---
# PowerShell:  -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
SESSION_SECRET=
POSTGRES_PASSWORD=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Optional ---
POSTGRES_USER=vaak
POSTGRES_DB=vaak
LIVEKIT_IMAGE_TAG=v1.8.0
MOCK=0
COOKIE_SECURE=1
