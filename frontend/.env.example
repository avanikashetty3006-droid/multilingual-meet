# Google Identity Services Client ID
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# API Base URL (defaults to /api in production when served behind reverse proxy)
VITE_API_BASE_URL=/api

# WebSocket User Presence / Notification URL (defaults to /ws)
VITE_WS_URL=/ws

# LiveKit Server URL (defaults to server-provided join URL, fallback here if needed)
VITE_LIVEKIT_URL=wss://livekit.example.com

# Enable development mock API (1 for dev mock without backend, 0 for real backend)
# Note: excluded from production builds automatically
VITE_API_MOCK=1
