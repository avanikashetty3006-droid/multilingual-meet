# Local development only (copy to frontend/.env.local). Production values come from docker-compose build args.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 1 = fake in-browser API (no backend needed, dev only). 0 = talk to the real call-server (npm run dev proxies /api and /ws to :8000).
VITE_API_MOCK=0

# Optional: only if the call-server is NOT reachable through the Vite/nginx proxy.
# VITE_CALL_SERVER_URL=http://localhost:8000
