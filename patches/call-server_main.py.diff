+class MainBridge(RoomBridge):
+    """Lets the A10 API reuse this file's LiveKit token code and room manager."""
+
+    async def join(self, meeting_id, participant_id, name, lang):
+        return {
+            "livekit_token": generate_livekit_token(meeting_id, participant_id, name),
+            "livekit_url": LIVEKIT_URL,
+        }
+
+    async def end_meeting(self, meeting_id):
+        room = await room_manager.get_room(meeting_id)
+        if not room:
+            return
+        await room.broadcast_json({"type": "meeting_ended", "room_id": meeting_id})
+        for p in list(room.participants.values()):
+            if p.ws is not None:
+                try:
+                    await p.ws.close(code=4410)
+                except Exception:
+                    pass
+
+
+def build_a10():
+    """A10 turns on only when SESSION_SECRET is set, so the old mock/load-test flow still runs without it."""
+    if not os.getenv("SESSION_SECRET"):
+        logger.warning("SESSION_SECRET not set: A10 API (/api/v1, /ws/user) is DISABLED. Set it to enable sign-in.")
+        return None
+    return create_a10(MainBridge(), A10Settings.from_env())
+
+
+a10 = build_a10()
