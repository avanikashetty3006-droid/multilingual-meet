+async def refuse_if_meeting_closed(websocket: WebSocket, room_id: str) -> bool:
+    """True (and the socket is closed) when this room is an ended / unknown meeting."""
+    if a10 and not await a10.room_allowed(room_id):
+        await websocket.accept()
+        try:
+            await websocket.send_json({"type": "meeting_ended", "room_id": room_id})
+        except Exception:
+            pass
+        await websocket.close(code=4410)
+        return True
+    return False
